# ==============================================================================
# MEDISCAN AI - CẤU HÌNH BIẾN MÔI TRƯỜNG BACKEND MẪU (.env.example)
# ==============================================================================
# Đồng bộ 100% với lớp Settings tại backend/app/core/config.py (pydantic-settings).
# Hướng tiếp cận: On-Premise OCR (PP-OCRv6 + VietOCR) + Multi-Tier Drug Resolution.

# --- CẤU HÌNH ỨNG DỤNG ---
APP_HOST=0.0.0.0
APP_PORT=8000

# --- TẦNG SUY LUẬN THUỐC LẠ & TPCN (STAGE 17 & 18) ---
ENABLE_LLM_DRUG_RESOLVER=true

# 1. Google Gemini Text API (Ưu tiên số 1 - Miễn phí 1.500 req/ngày)
# Lấy Key tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 2. Groq Cloud API (Ưu tiên số 2 - Siêu tốc độ 500+ tokens/giây, Miễn phí)
# Lấy Key tại: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# 3. Local LLM (Ollama Local - Chạy 100% Offline trên máy tính)
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen2.5:1.5b

# --- OPENFDA DRUG DATABASE API ---
OPENFDA_API_KEY=
OPENFDA_BASE_URL=https://api.fda.gov/drug

# --- OCR ENGINE (Stage 2, On-Premise PP-OCRv6 ONNX — Zero External VLM) ---
OCR_MAX_DIM=1600
OCR_LANG=vi
OCR_ENGINE=onnxruntime
OCR_DOC_ORIENTATION=false
OCR_DOC_UNWARPING=false
OCR_PROCESSING_SLA_MS=15000

# --- AUTHENTICATION (Stage 8) ---
# BẮT BUỘC: Khởi tạo chuỗi ngẫu nhiên bảo mật (VD: python -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
