# Khung cấu hình các biến môi trường cho Backend Mediscan AI.
# Đồng bộ 100% với lớp Settings tại backend/app/core/config.py (pydantic-settings).
# KHÔNG có VLM thương mại (Gemini Vision) — OCR chạy On-Premise.
# Mọi biến có giá trị mặc định trong Settings nên có thể bỏ trống nếu dùng default.

# --- APP CONFIG ---
APP_HOST=0.0.0.0
APP_PORT=8000

# --- LLM VĂN BẢN DỰ PHÒNG (fallback text-only, không phải Vision) ---
# Giữ lại theo Task 3.3 (Clinical LLM Assessment).
OPENAI_API_KEY=your_openai_api_key_here
# [P3/F3.9] Model fallback text-only — đổi qua env khi cần, không hardcode trong code
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# --- LOCAL LLM (for Clinical Assessment) - Ollama hoặc tương tự ---
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen2.5:0.5b

# --- OpenFDA DRUG DATABASE API ---
OPENFDA_API_KEY=
OPENFDA_BASE_URL=https://api.fda.gov/drug

# --- OCR ENGINE (Stage 2, On-Premise PP-OCRv6 ONNX — Zero External VLM) ---
# Feature toggle & tuning. Mặc định đã chốt SLA benchmark (avg 5.59s/ảnh CPU).
# KHÔNG bật OCR_DOC_* trừ khi ảnh chụp nghiêng/cong vồng (tốn CPU, tăng latency).
OCR_MAX_DIM=1600
OCR_LANG=vi
OCR_ENGINE=onnxruntime
OCR_DOC_ORIENTATION=false
OCR_DOC_UNWARPING=false
OCR_PROCESSING_SLA_MS=15000

# --- AUTHENTICATION (Stage 8) ---
# BẮT BUỘC: Khởi tạo chuỗi ngẫu nhiên bảo mật (VD: python -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

