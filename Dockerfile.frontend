# ============================================================
# Mediscan AI - Dockerfile.frontend (Next.js 16)
# Multi-stage build: deps -> builder -> standalone runner
# ============================================================

# ---------- STAGE 1: Dependencies ----------
FROM node:20-alpine AS deps

# libc6-compat: chứa glibc compatibility layer cần thiết cho các native binaries
RUN apk add --no-cache libc6-compat

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

# Copy lockfile để cài đặt chính xác phiên bản dependencies
COPY frontend/package.json frontend/package-lock.json ./

# npm ci: cài toàn bộ deps (bao gồm devDependencies để compile CSS tại bước build).
# npm install -D lightningcss-linux-x64-musl: ép tải binary C++ native binding
# dành riêng cho Alpine (musl libc) mà npm không tự lấy được.
RUN npm ci && npm install -D lightningcss-linux-x64-musl

# ---------- STAGE 2: Builder ----------
FROM node:20-alpine AS builder

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=production

# Public API URL - cần được inline vào bundle client tại thời điểm build.
# Mặc định trỏ về Backend qua cổng publish 8000 (mà trình duyệt truy cập được).
ARG NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ ./

RUN npm run build

# ---------- STAGE 3: Runner (Standalone) ----------
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Security: user non-root
RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nextjs

# Copy static assets & standalone server bundle
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Healthcheck cho Docker Compose
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD node -e "fetch('http://localhost:3000/').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))" || exit 1

CMD ["node", "server.js"]